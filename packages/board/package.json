{
  "name": "@vorq/board",
  "version": "0.1.1",
  "description": "Web dashboard for Vorq",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vorq-board": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./express": {
      "import": "./dist/express.js",
      "require": "./dist/express.cjs",
      "types": "./dist/express.d.ts"
    },
    "./ui-assets": {
      "default": "./dist/ui/"
    }
  },
  "files": ["dist", "CHANGELOG.md"],
  "scripts": {
    "build": "npm run build:ui && npm run build:server",
    "build:ui": "vite build",
    "build:server": "tsup",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "clsx": "2.1.1",
    "fastify": "^5.12.5",
    "tailwind-merge": "3.6.0"
  },
  "peerDependencies": {
    "@vorq/core": "^0.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-query": "^5.60.0",
    "@tanstack/react-table": "^8.20.0",
    "@types/express": "5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "commander": "^12.0.0",
    "express": "5.2.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "vorq",
    "dashboard",
    "queue-dashboard",
    "task-queue",
    "job-queue",
    "admin-ui",
    "dead-letter-queue",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/baccaraaa/vorq",
    "directory": "packages/board"
  },
  "homepage": "https://github.com/baccaraaa/vorq/tree/main/packages/board#readme",
  "bugs": "https://github.com/baccaraaa/vorq/issues",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
