{
  "name": "@vorq/nestjs",
  "version": "0.2.0",
  "description": "NestJS integration for Vorq",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "CHANGELOG.md"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "vorq",
    "nestjs",
    "nest",
    "task-queue",
    "job-queue",
    "background-jobs",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/baccaraaa/vorq",
    "directory": "packages/nestjs"
  },
  "homepage": "https://github.com/baccaraaa/vorq/tree/main/packages/nestjs#readme",
  "bugs": "https://github.com/baccaraaa/vorq/issues",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "@vorq/core": "^0.2.0"
  },
  "devDependencies": {
    "@nestjs/common": "11.1.17",
    "@nestjs/core": "11.1.17",
    "@nestjs/testing": "11.1.17",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  }
}
