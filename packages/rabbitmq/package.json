{
  "name": "@vorq/rabbitmq",
  "version": "0.2.0",
  "description": "RabbitMQ transport adapter for Vorq",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "CHANGELOG.md"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "vorq",
    "task-queue",
    "job-queue",
    "rabbitmq",
    "amqp",
    "background-jobs",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/baccaraaa/vorq",
    "directory": "packages/rabbitmq"
  },
  "homepage": "https://github.com/baccaraaa/vorq/tree/main/packages/rabbitmq#readme",
  "bugs": "https://github.com/baccaraaa/vorq/issues",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "amqplib": "0.10.5"
  },
  "devDependencies": {
    "@types/amqplib": "0.10.6"
  },
  "peerDependencies": {
    "@vorq/core": "^0.2.0"
  }
}
